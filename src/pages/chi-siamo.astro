---
import BaseLayout from '../layouts/BaseLayout.astro';

const founders = [
  {
    name: 'Ing. Nicolò Pisoni',
    image: '/images/fondatore-pisoni.jpg',
    bio: 'Laureato in Ingegneria Civile, Università di Trento (2018). Iscritto all’Ordine degli Ingegneri di Trento (n. 4308). Abilitato CSP/CSE (d.lgs. 81/2008) e lavori su funi.',
  },
  {
    name: 'Ing. Luca Heron Cinquetti',
    image: '/images/fondatore-cinquetti.jpg',
    bio: 'Ingegneria Civile con specializzazione in Geotecnica — Politecnico di Milano (2015) e Università di Padova (2018). Albo ingegneri Sez. A Trento n. 4963. Abilitato CSP/CSE e lavori su funi.',
  },
];
---

<BaseLayout
  title="Chi siamo — ALPINGEO"
  description="ALPINGEO Engineering S.r.l.: studio di ingegneria geotecnica radicato in Alto Adige, Bolzano."
>
  <section class="hero hero-compact" aria-label="Chi siamo">
    <div class="hero-media" aria-hidden="true">
      <img src="/images/hero-page.jpg" alt="" width="2400" height="1600" fetchpriority="high" />
    </div>
    <div class="hero-content">
      <p class="eyebrow" style="color: #ffb3b3;">Chi siamo</p>
      <h1>Ingegneria radicata in Alto Adige</h1>
      <p class="hero-lead">
        Specializzazione in geotecnica, supporto multidisciplinare e attenzione al territorio.
      </p>
    </div>
    <p class="hero-credit">Foto: Unsplash</p>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Posizionamento</p>
        <h2>Ingegneria che parte dal terreno</h2>
        <p>
          ALPINGEO opera in Alto Adige (Südtirol) e nelle aree limitrofe. Affianchiamo committenze
          pubbliche e private su indagini geotecniche, progettazione di fondazioni e interventi di
          consolidamento, direzione lavori e sicurezza — con attenzione alla tutela del territorio.
        </p>
      </div>

      <div class="reveal">
        <p class="eyebrow">Fondatori</p>
        <h2 style="margin: 0 0 0.5rem; font-size: clamp(1.8rem, 3.4vw, 2.4rem);">
          Chi guida lo studio
        </h2>
      </div>

      {
        founders.map((person) => (
          <article class="founder reveal">
            <img src={person.image} alt={person.name} width="280" height="340" loading="lazy" />
            <div>
              <p class="role">Fondatore</p>
              <h3>{person.name}</h3>
              <p>{person.bio}</p>
            </div>
          </article>
        ))
      }

      <div class="company-card reveal">
        <p class="eyebrow">Dati societari</p>
        <h2 style="margin: 0; font-size: 1.6rem;">ALPINGEO Engineering S.r.l.</h2>
        <dl>
          <dt>Sede</dt>
          <dd>Corso della Libertà, 15 — 39100 Bolzano (BZ)</dd>
          <dt>C.F. / P.IVA</dt>
          <dd>03335530212</dd>
          <dt>REA</dt>
          <dd>BZ-251422</dd>
          <dt>Capitale</dt>
          <dd>10.000,00 €</dd>
          <dt>Email</dt>
          <dd><a href="mailto:infoalpingeo@gmail.com">infoalpingeo@gmail.com</a></dd>
          <dt>PEC</dt>
          <dd><a href="mailto:alpingeo@legalmail.it">alpingeo@legalmail.it</a></dd>
        </dl>
      </div>
    </div>
  </section>
</BaseLayout>
